{
  "name": "flag",
  "displayName": "Flag",
  "description": "Flag (.flg): highlighting, errors as you type, hover and go to definition",
  "version": "0.2.0",
  "publisher": "framaluna",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/FramaLuna/flag-lsp.git"
  },
  "homepage": "https://github.com/FramaLuna/flag-lsp#readme",
  "bugs": {
    "url": "https://github.com/FramaLuna/flag-lsp/issues"
  },
  "main": "./extension.js",
  "icon": "icons/flag-128.png",
  "activationEvents": [
    "onLanguage:flag",
    "workspaceContains:**/*.flg"
  ],
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "flag",
        "aliases": [
          "Flag"
        ],
        "extensions": [
          ".flg"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/flag.svg",
          "dark": "./icons/flag.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "flag",
        "scopeName": "source.flag",
        "path": "./syntaxes/flag.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Flag",
      "properties": {
        "flag.server": {
          "type": "string",
          "default": "",
          "description": "The flagls to run instead of the one that comes with the extension. flagls runs the flagc next to it, or the one in your PATH. A relative path starts at the workspace folder."
        },
        "flag.memory": {
          "type": "boolean",
          "default": false,
          "description": "Also show the warnings of the memory checker, flagc -memory. It makes every check slower."
        },
        "flag.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Folders or files, relative to the workspace folder, that flagls leaves out. Everything else is checked."
        }
      }
    }
  }
}
